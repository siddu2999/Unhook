
{
    "manifest_version": 3,
    "name": "Unhook",
    "version": "1.0.0",
    "description": "A distraction-free YouTube experience By Siddheeshwar.",
    
    "permissions": [
        "storage"
    ],

    "host_permissions": [
        "https://www.youtube.com/*"
    ],

    "action": {
        "default_popup": "mm.html"
    },
 
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}

